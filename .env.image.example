# ============================================
# ABXY ARCADE — 镜像部署配置模板
# 复制为 .env 后修改，再执行：
#   docker compose -f docker-compose.image.yml up -d
# ============================================

# 【一般不用改】镜像地址
# 官方：ghcr.io/doulicon/abxy-arcade:latest
# 国内拉不动时改成加速源：ghcr.nju.edu.cn/doulicon/abxy-arcade:latest
IMAGE_NAME=ghcr.io/doulicon/abxy-arcade:latest

# 对外访问端口（宿主机端口，浏览器访问 http://服务器IP:此端口）
HOST_PORT=30000

# 数据目录（数据库、封面、素材、BIOS、JWT 密钥等）
# 相对路径是相对 docker-compose.image.yml 所在目录；也可写绝对路径如 /mnt/docker/abxy/data
DATA_PATH=./data

# ROM 目录（把游戏 ROM 文件丢进这个目录即可被扫描到）
# 想换到别处就改成绝对路径，例如 /mnt/roms
ROM_PATH=./data/roms

# 管理员账号（仅首次启动、数据库无该账号时生效）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# 是否开放普通用户注册（true / false）
ALLOW_REGISTER=true

# 时区
TZ=Asia/Shanghai

# JWT 密钥：默认留空，自动持久化在 data/.jwt-secret（推荐，登录态不失效）
# JWT_SECRET=please-change-this-secret-in-production
