# 统一换行符，避免 Windows 检出后 shell 脚本在 Linux 上报 bad interpreter
* text=auto

*.sh    text eol=lf
*.bash  text eol=lf

# Dockerfile / compose / CI 配置统一 LF，避免 Windows 检出后构建异常
Dockerfile        text eol=lf
docker-entrypoint.sh text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
.env.example      text eol=lf
.env.image.example text eol=lf

# 二进制文件不做换行转换
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.zip   binary
*.db    binary
*.woff  binary
*.woff2 binary

# Windows 批处理必须保持 CRLF
*.bat   text eol=crlf
*.cmd   text eol=crlf
