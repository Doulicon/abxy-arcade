# 强制 shell 脚本使用 LF 行尾
# Windows 上 core.autocrlf=true 会把 .sh 检出成 CRLF，导致 Linux 上执行报
# "not found" / "\r: command not found"。这里显式覆盖。
*.sh text eol=lf

# Dockerfile / entrypoint 同样需要 LF
Dockerfile text eol=lf
docker-entrypoint.sh text eol=lf

# 文本文件统一按 LF 检出
*.js text eol=lf
*.mjs text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.css text eol=lf
*.html text eol=lf
*.txt text eol=lf

# 二进制文件不做行尾转换
*.wasm binary
*.data binary
*.zip binary
*.gz binary
*.webp binary
*.jpg binary
*.jpeg binary
*.png binary
*.ico binary
*.woff binary
*.woff2 binary
