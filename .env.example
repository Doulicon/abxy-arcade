# ============================================
# ABXY ARCADE 部署配置模板
# 复制本文件为 .env，按需修改，然后 docker compose up -d --build
# ============================================

# 对外访问端口（宿主机端口，浏览器访问 http://服务器IP:此端口）
HOST_PORT=30000

# 数据目录（数据库、封面、素材、BIOS、JWT 密钥等）
# 相对路径是相对 docker-compose.yml 所在目录
DATA_PATH=./data

# ROM 目录（玩家把游戏 ROM 文件丢进这个目录即可）
# 想换到别的地方就改成绝对路径，例如 /mnt/roms 或 /home/xxx/roms
ROM_PATH=./data/roms

# 管理员账号（仅首次启动、数据库无该账号时生效）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# 是否开放普通用户注册（true / false）
ALLOW_REGISTER=true

# JWT 密钥：默认留空，自动持久化在 data/.jwt-secret（推荐，登录态不失效）
# 如需固定密钥，取消注释并填随机长字符串（改动后所有已登录用户需重新登录）
# JWT_SECRET=please-change-this-secret-in-production

# 构建用的基础镜像（只影响源码构建，镜像部署不看这个）
# 国内直连 Docker Hub 会报：
#   failed to resolve source metadata for docker.io/library/node:22-bookworm-slim
# 这时取消下面注释换成本地加速源即可，不影响镜像内容：
# BASE_IMAGE=docker.1panel.live/library/node:22-bookworm-slim
# 备选：docker.m.daocloud.io  /  docker.1ms.run（前缀同样加 /library/）
