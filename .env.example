# ============================================================================
# ABXY ARCADE 环境变量模板
# 复制本文件为 .env 后按需修改：cp .env.example .env
# .env 已被 .gitignore 排除，不会被提交到仓库
# ============================================================================

# NAS 上对外暴露的端口（容器内固定 3000）
HOST_PORT=30000

# 时区
TZ=Asia/Shanghai

# ---------------------------------------------------------------------------
# 运行身份（容器内 node 用户的 UID/GID）
# ---------------------------------------------------------------------------
# 飞牛 fnOS：SSH 登录后执行 `id` 查看，通常是 uid=1000(Fan) gid=1001(Users)
# 群晖 DSM：通常 1026:100 或 1026:101
# 威联通 QTS：通常 1000:100
# Unraid：默认 1000:100
PUID=1000
PGID=1001

# 数据目录权限修正策略：
#   auto   —— 仅当容器内 node 用户不可写时才递归修正（默认，兼顾启动速度与可用性）
#   always —— 始终递归 chown（数据卷属主混乱时用）
#   never  —— 完全不动权限（数据卷已由宿主正确授权时用，启动最快）
CHOWN_DATA=auto

# ---------------------------------------------------------------------------
# 数据卷路径
# ---------------------------------------------------------------------------
# 相对路径基于本文件所在目录解析（推荐：./data，容器内固定挂载到 /data）
# 飞牛 fnOS 绝对路径示例：/vol1/1000/docker/abxy-arcade/data
DATA_PATH=./data

# ---------------------------------------------------------------------------
# 安全配置（务必修改）
# ---------------------------------------------------------------------------
# JWT 签名密钥：改后所有已登录用户需要重新登录
JWT_SECRET=please-change-this-secret-in-production

# 首次启动时自动创建的管理员账号（已存在则忽略）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# 是否开放普通用户注册
ALLOW_REGISTER=true
